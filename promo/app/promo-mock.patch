+import { readFileSync, existsSync } from 'node:fs'
+import { join } from 'node:path'
 
 /**
+ * PROMO ONLY (scratch copy): stands in for the `tile://` protocol so the
+ * `?promo=1` mock draws real pages, real detection masks and real cleaned
+ * layers produced by the pipeline (see promo/app/prepare_assets.py).
+ */
+function promoTiles() {
+  const root = join(process.cwd(), 'public/promo')
+  return {
+    name: 'promo-tiles',
+    configureServer(server) {
+      server.middlewares.use('/__promo_tile/', (req, res, next) => {
+        const manifest = JSON.parse(readFileSync(join(root, 'manifest.json'), 'utf8'))
+        const path = decodeURIComponent((req.url ?? '').split('?')[0]).replace(/^\/+/, '')
+        const [chapterId, pageIndex, variant, rest] = path.split('/')
+        const page = manifest.chapters[chapterId]?.[Number(pageIndex)]
+        const entry = page && manifest.pages[page]
+        res.setHeader('Access-Control-Allow-Origin', '*')
+        res.setHeader('Access-Control-Expose-Headers', 'x-layer-bounds, x-mask-bounds')
+        res.setHeader('Cache-Control', 'no-store')
+        if (!entry) { res.statusCode = 404; return res.end() }
+        let file = null
+        if (variant === 'source' || variant === 'cleaned') file = join(root, 'src', `page-${page}.png`)
+        const k = /-r(\d+)$/.exec(rest ?? '')?.[1]
+        if (variant === 'layer') {
+          const b = k !== undefined ? entry.layers[k] : null
+          if (!b) { res.statusCode = 204; return res.end() }
+          res.setHeader('x-layer-bounds', b.join(','))
+          file = join(root, 'layer', `page-${page}-r${k}.png`)
+        }
+        if (variant === 'detection') {
+          const b = k !== undefined ? entry.dets[k] : null
+          if (!b) { res.statusCode = 404; return res.end() }
+          res.setHeader('x-mask-bounds', b.join(','))
+          file = join(root, 'det', `page-${page}-r${k}.png`)
+        }
+        if (!file || !existsSync(file)) { res.statusCode = 404; return res.end() }
+        res.setHeader('Content-Type', 'image/png')
+        res.end(readFileSync(file))
+      })
+    },
+  }
+}
