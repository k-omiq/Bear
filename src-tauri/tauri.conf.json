{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Manga Cleaner",
  "version": "1.0.0-beta.2",
  "identifier": "com.mangacleaner.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Manga Cleaner",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: tile: http://tile.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost tile: http://tile.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/windows-crt/*": "",
      "../sidecar": "sidecar",
      "../sam-bootstrap/bootstrap.py": "sam-bootstrap/bootstrap.py",
      "../spikes/sam-ts-l/export_mask.py": "sam-bootstrap/export_mask.py",
      "../spikes/sam-ts-l/environment.txt": "sam-bootstrap/environment.txt",
      "../spikes/sam-ts-l/fixtures/synthetic_page.png": "sam-bootstrap/synthetic_page.png"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cleaner.komiq.cc/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1N0NBOUQ5M0Y0MjlENzMKUldSem5VSS8yYWw4SlI1N29wRllLcE96aUtoeTNDVUFJZW1rS2ZtVFdpSDE0ZkNKNWhYV2d3dDYK"
    }
  }
}
