{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window is allowed to ask for. Deliberately short: every capability added here is surface a compromised page could reach.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "updater:default",
    "process:default",
    "allow-app-commands",
    "allow-inference-commands",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/k-omiq/manga-cleaner"
        },
        {
          "url": "https://discord.gg/3ueKc9PaX7"
        }
      ]
    }
  ]
}
