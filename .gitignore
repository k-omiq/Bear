# Rust / Tauri
target/
src-tauri/target/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Downloaded model weights and native runtimes (never commit)
models/
runtimes/

# Session caches and job scratch
*.mtclean.d/
.cache/

# OS
.DS_Store
Thumbs.db

# Superpowers / SDD scratch
.superpowers/

# Cargo workspace lock is committed; per-crate build output is not
Cargo.lock.orig

# Tauri generated
src-tauri/gen/
src-tauri/permissions/autogenerated/

# The rung 3a sidecar's Python environment and its weights. The application
# ships no Python, so this is user-installed, absent by default, and never
# committed - the same rule the model weights above follow.
# The sidecar's source under sidecar/ *is* committed; only its environment,
# its weights, its bytecode and its editable-install metadata are not.
.sidecar-venv/
__pycache__/
*.pyc
*.egg-info/

# nested clone of gecallidryas/freeditor (own git repo)
freeditor/

# Local agent tooling config. Never committed.
.claude/

# The Visual C++ runtime DLLs staged beside the Windows executable. The shipped
# `onnxruntime.dll` imports MSVCP140, MSVCP140_1, VCRUNTIME140 and
# VCRUNTIME140_1 outright, so a machine without the redistributable cannot load
# the runtime at all; the release workflow copies them out of the build host's
# own Visual Studio redist folder into this directory, and Tauri bundles them
# next to the executable, where the loader's search order finds them first.
# They come from the build machine and are never committed - only the note that
# explains the directory is.
src-tauri/vendor/windows-crt/*.dll

# Frozen platform-specific cloud setup helper built on release runners.
src-tauri/binaries/manga-cleaner-provisioner-*

# Managed Python launcher staged by .github/scripts/stage-flux-python.py.
src-tauri/binaries/manga-cleaner-uv-*

# Working notes of one fix set: plans, progress, reports and picture sheets.
# Local only.
docs/fixes-*/

# Helper scripts written for one probe measurement. The probe's Rust source is
# committed; these are not.
spikes/gate-probe/*.py

# Plans, progress logs and reports. They are working papers and stay on the
# machine that wrote them. The reference documents in docs/ (contracts, the
# feature list, findings.md) are committed.
/Plan for models/
/manga-cleaner-cloud-master-plan.md
docs/*-plan.md
docs/research/*-plan.md
docs/*-report.md
docs/*-audit*.md
docs/*-evidence*.md
docs/*-validation*.md
docs/*-20[0-9][0-9]-[0-9][0-9]-[0-9][0-9].md
docs/*-work-log.md
docs/*-ledger.md
docs/*-handoff.md
docs/cloud-feasibility.md
docs/cloud-queue-latency.md
docs/denoise-queue-fix.md

# Generated output: the rendered promo video and its stills, and the icon
# exploration runs. The final icon is design/icon.png and design/icon.svg.
promo/out/
# The recorded app clips (promo/app/record.mjs). Hundreds of MB, made again
# by recording, and kept out of history so a clone stays small.
promo/app/clips/
promo/app/clips-seek/
design/icon-explore/

# Wrangler and Miniflare local state.
.wrangler/
